<?xml version="1.0" encoding="utf-8" ?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="VKey.exe" min-matches="0" />
      <include path="VKeyClassic.exe" min-matches="0" />
      <include path="VKeyTSF.dll" min-matches="0" />
      <include path="VKeyWatchdog.exe" min-matches="0" />
      <!-- Bundled Sciter runtime ships unsigned from the vendor; sign it so every PE
           in the release ZIP is Authenticode-signed. -->
      <include path="sciter.dll" min-matches="0" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
